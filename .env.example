# where the database is - the one place for it. the agent (upi), the website's
# build (web/) and the module's deploy (cd module && npm run deploy) all read
# this. copy it to .env and fill it in; real environment variables override it

# the SpacetimeDB host. https:// or wss:// - each side converts to what it needs
UPI_SERVER=https://maincloud.spacetimedb.com
# the name the module's published as
UPI_DB=
# where the website's hosted - only for the links `upi pair` prints
UPI_SITE=
